# ============================================
# Stellar Drips — Environment Variables
# ============================================

# --- Stellar Network ---
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
NEXT_PUBLIC_NETWORK=testnet

# --- Contract Addresses ---
NEXT_PUBLIC_CONTRACT_ID=CCEWB5F27ETPU7FAQWDEWEGGTL4DIUCWNHU36RV2MDXSSGFJUDSONPAC
# Native XLM Stellar Asset Contract on testnet. Leave unset to use this default.
NEXT_PUBLIC_TOKEN_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Optional custom test token for non-XLM demos:
# NEXT_PUBLIC_TOKEN_ID=CDFJZD3D5Y2RF27NFM4BPDMSKYMDMD5AT2ZQCAWAXAZZBONUB3M3BNCO

# --- WalletConnect (optional — enables WalletConnect support) ---
# Get a project ID at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- UI Defaults ---
NEXT_PUBLIC_DEFAULT_RECIPIENT=
NEXT_PUBLIC_EXPLORER_BASE_URL=https://stellar.expert/explorer/testnet

# --- Scheduler / Keeper (NEVER expose to frontend) ---
KEEPER_SECRET_KEY=
SCHEDULER_DRY_RUN=true
SCHEDULER_INTERVAL_SECONDS=60
SUBSCRIPTIONS_REGISTRY=./scripts/subscriptions.json
